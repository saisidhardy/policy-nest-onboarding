# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=policynest
POSTGRES_PASSWORD=
POSTGRES_DB=policynest

APP_ENV=development
SECRET_KEY=
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email. docker compose ships Mailpit (local mail catcher, UI on http://localhost:8025).
# For real delivery point these at your SMTP provider (SES, SendGrid, Postmark, ...).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="PolicyNest <no-reply@policynest.local>"

# Pilot assessment policy. Production values require compliance approval.
EXAM_MAX_ATTEMPTS=3
EXAM_RETAKE_COOLDOWN_HOURS=24
