# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_USER=policynest
POSTGRES_PASSWORD=
POSTGRES_DB=policynest

APP_ENV=development
SECRET_KEY=
PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Email. docker compose ships Mailpit (local mail catcher, UI on http://localhost:8025).
# For real delivery point these at your SMTP provider (SES, SendGrid, Postmark, ...).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="PolicyNest <no-reply@policynest.local>"
EMAIL_MAX_ATTEMPTS=3

# Document storage: "local" (private backend filesystem) or "s3" (AWS S3 / MinIO).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_SIZE_MB=10
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=policynest-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis (background jobs / rate limiting)
REDIS_URL=redis://redis:6379/0

# Phase 3 & Phase 8: OCR, AI assistant (advisory only), and external verification provider adapters
# OCR_PROVIDER: "local_tesseract", "http_ocr", or "none"
OCR_PROVIDER=local_tesseract
OCR_API_BASE_URL=
OCR_API_KEY=
TESSERACT_CMD=

# AI_PROVIDER: "local_heuristic" or "gemini"
AI_PROVIDER=local_heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

IFSC_LOOKUP_ENABLED=true
PAN_VERIFICATION_PROVIDER=not_configured
PAN_API_BASE_URL=
PAN_API_KEY=
BANK_VERIFICATION_PROVIDER=not_configured
BANK_API_BASE_URL=
BANK_API_KEY=
DIGILOCKER_PROVIDER=not_configured
DIGILOCKER_BASE_URL=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
FACE_MATCH_PROVIDER=not_configured
FACE_API_BASE_URL=
FACE_API_KEY=

# Phase 8: SMS gateway ("not_configured", non-production "sandbox", "twilio", "msg91", "webhook_http")
SMS_PROVIDER=not_configured
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=PLCNST
SMS_TIMEOUT_SECONDS=8
SMS_MAX_ATTEMPTS=3

# Phase 8: Signed inbound verification webhooks & shared HTTP transport resilience
WEBHOOK_SHARED_SECRET=
INTEGRATION_HTTP_TIMEOUT_SECONDS=8
INTEGRATION_HTTP_MAX_RETRIES=2

# Phase 6: External LMS adapter ("not_configured", "http_api", or non-production "sandbox")
LMS_PROVIDER=not_configured
LMS_API_BASE_URL=
LMS_API_KEY=
LMS_WEBHOOK_SECRET=
LMS_COURSE_CODE=IRDAI-POSP-15H
LMS_REQUIRED_HOURS=15.0
LMS_PASSING_SCORE_PCT=50.0
LMS_TIMEOUT_SECONDS=8
LMS_EXAM_COOLDOWN_HOURS=24
LMS_CERTIFICATE_VALIDITY_YEARS=3
LMS_SYNC_RETRY_BASE_SECONDS=300
LMS_SYNC_MAX_ATTEMPTS=5
